# Copy to .env and replace the example values. Never commit .env.
POSTGRES_DB=invoice_auditor
POSTGRES_USER=invoice_app
POSTGRES_PASSWORD=replace_with_a_long_random_password

# AWS Bedrock credentials/profile configuration: supply only what your chosen AWS auth
# method needs. Prefer an IAM role/profile or mounted credentials over static keys.
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# Model IDs must match the models enabled for your AWS account/region.
BEDROCK_REASONING_MODEL=
BEDROCK_RAG_MODEL=
BEDROCK_TRANSLATION_MODEL=

# Optional application settings
LOG_LEVEL=INFO
